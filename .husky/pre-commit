#!/bin/sh
echo "Running pre-commit hook..."

# Run spell check
git diff --cached --name-only | npx cspell "src/**/*.{ts,js,json}" --no-summary --no-progress --no-must-find-files --file-list stdin

# Lint staged files
npx lint-staged

# Build
npm run build

# Bump patch version without git tagging
npm version patch --no-git-tag-version
git add package.json

echo "🔍 Running Gitleaks pre-commit scan..."

# Check if gitleaks exists
if command -v gitleaks >/dev/null 2>&1; then
  echo "✅ Gitleaks already installed"
else
  echo "⚠️ Gitleaks not found. Installing..."
  OS="$(uname -s)"
  if [ "$OS" = "Darwin" ]; then
    brew install gitleaks
  elif [ "$OS" = "Linux" ]; then
    curl -sSfL https://raw.githubusercontent.com/gitleaks/gitleaks/master/install.sh | sh
    export PATH="$PATH:$HOME/.local/bin"
  else
    echo "ℹ️ Auto-install not supported on this OS. Please install Gitleaks manually."
  fi
fi

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --staged --redact
  echo "✅ Gitleaks scan passed"
fi

echo "🔍 Running Semgrep pre-commit scan..."

# Check if semgrep exists
if command -v semgrep >/dev/null 2>&1; then
  echo "✅ Semgrep already installed"
else
  echo "⚠️ Semgrep not found. Installing..."
  OS="$(uname -s)"
  if [ "$OS" = "Darwin" ]; then
    brew install semgrep
  elif [ "$OS" = "Linux" ]; then
    curl -sSfL https://install.semgrep.dev | sh
    export PATH="$PATH:$HOME/.local/bin"
  else
    echo "ℹ️ Auto-install not supported on this OS. Please install Semgrep manually."
  fi
fi

if command -v semgrep >/dev/null 2>&1; then
  FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(js|ts|jsx|tsx)$' || true)
  if [ -n "$FILES" ]; then
    export PYTHONUTF8=1
    semgrep --config=auto --error $FILES
    STATUS=$?
  else
    echo "ℹ️ No JS/TS files staged. Skipping Semgrep."
    STATUS=0
  fi
  if [ $STATUS -ne 0 ]; then
    echo "❌ Semgrep scan failed"
    exit $STATUS
  fi
fi

echo "🔍 Running Trivy pre-commit scan..."

# Check if trivy exists
if command -v trivy >/dev/null 2>&1; then
  echo "✅ Trivy already installed"
else
  echo "⚠️ Trivy not found. Installing..."
  OS="$(uname -s)"
  if [ "$OS" = "Darwin" ]; then
    brew install aquasecurity/trivy/trivy
  elif [ "$OS" = "Linux" ]; then
    curl -sfL https://raw.githubusercontent.com/aquasecurity/trivy/main/contrib/install.sh | sh -s -- -b /usr/local/bin
  else
    echo "ℹ️ Auto-install not supported on this OS. Please install Trivy manually."
  fi
fi

if command -v trivy >/dev/null 2>&1; then
  trivy fs --severity HIGH,CRITICAL .
  echo "✅ Trivy scan passed"
fi

echo "✅ Pre-commit hooks completed successfully"
